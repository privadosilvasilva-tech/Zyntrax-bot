# Copie este arquivo para ".env" e preencha com os dados do seu banco Neon
# (veja o passo a passo no README, seção "Banco de dados").
# NUNCA suba o arquivo ".env" para o GitHub ou qualquer lugar público.

# Connection string do banco Postgres do Neon (gratuito) - obrigatório.
# Copie ela inteira direto do painel do Neon, algo como:
# postgresql://usuario:senha@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=cole_aqui_a_connection_string_do_neon

# Porta do servidor (opcional)
PORT=3000

# Nome da turma, exibido no site (opcional)
NOME_DA_TURMA=Minha Turma
